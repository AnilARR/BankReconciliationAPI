# Only needed when the dashboard is NOT served behind the same origin as the API
# (e.g. hosting the static build on a CDN). Then also set RECON_CORS_ORIGINS on the API.
# VITE_API_BASE_URL=https://recon-api.example.com

# Where `npm run dev` proxies /api during local development.
# VITE_API_TARGET=http://localhost:8000
